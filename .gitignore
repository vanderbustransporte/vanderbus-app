# Credenciales locales (ver .env.example)
.env
.env.*
!.env.example

# Editor directories and files
# Ojo: tiene que ser ".vscode/*" con glob, NO ".vscode/". Si se ignora la carpeta
# entera, git ni siquiera la recorre y los "!" de abajo no re-incluyen nada.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Cache local de la CLI de Supabase (link al proyecto, versiones) - no es del repo
supabase/.temp/

# Prompts y notas personales sueltas en la raiz (no son del proyecto)
prompt.txt
prompt-*.md
prompt-*.txt
